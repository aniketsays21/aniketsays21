# Application
APP_NAME=AI UGC Video Platform
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ugc_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Storage
STORAGE_TYPE=local  # Options: local, s3, gcs
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes

# AWS S3 (if using)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# AI Models Configuration
USE_LOCAL_MODELS=True  # Set False to use API services
MODEL_CACHE_DIR=./model_cache

# Video Generation
VIDEO_MODEL=magicanimate  # Options: magicanimate, animatediff
VIDEO_RESOLUTION=512x512
VIDEO_FPS=24
VIDEO_DURATION=5  # seconds
MAX_VIDEO_DURATION=30

# Replicate API (for cloud-based generation)
REPLICATE_API_TOKEN=

# Voice Synthesis
VOICE_MODEL=bark  # Options: bark, coqui, elevenlabs
BARK_MODEL_SIZE=small  # Options: small, large
ENABLE_VOICE_CLONING=True

# ElevenLabs (if using)
ELEVENLABS_API_KEY=

# Background Removal
BG_REMOVAL_MODEL=rembg  # Options: rembg, sam
SAM_MODEL_TYPE=vit_h

# Scraping
PLAYWRIGHT_HEADLESS=True
SCRAPING_TIMEOUT=30000  # milliseconds
MAX_IMAGES_PER_PRODUCT=10
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Features
ENABLE_ANALYTICS=False
ENABLE_CACHING=True
CACHE_TTL=3600  # seconds

# GPU Settings
CUDA_VISIBLE_DEVICES=0
ENABLE_GPU=True
GPU_MEMORY_FRACTION=0.8

# Queue Settings
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=600  # seconds
